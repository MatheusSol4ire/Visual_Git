{
  "name": "visual-git",
  "displayName": "Visual Git",
  "description": "Veja o histórico de commits do seu projeto de forma visual, simples e bonita.",
  "version": "0.0.1",
  "private": true,
  "publisher": "matheussol4ire",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MatheusSol4ire/Visual_Git.git"
  },
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=22.18.0"
  },
  "categories": [
    "SCM Providers",
    "Visualization"
  ],
  "keywords": [
    "git",
    "graph",
    "history",
    "commits",
    "visual",
    "histórico",
    "grafo",
    "iniciante",
    "visualizar"
  ],
  "type": "module",
  "main": "./dist/extension.cjs",
  "activationEvents": [],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "O Visual Git executa o Git na pasta aberta. Por segurança, só funciona em pastas marcadas como confiáveis."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "visualGit",
          "title": "Visual Git",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "visualGit": [
        {
          "type": "webview",
          "id": "visualGit.commits",
          "name": "Commits"
        }
      ]
    },
    "commands": [
      {
        "command": "visualGit.open",
        "title": "Mostrar histórico de commits",
        "category": "Visual Git"
      },
      {
        "command": "visualGit.refresh",
        "title": "Atualizar",
        "category": "Visual Git",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "visualGit.refresh",
          "when": "view == visualGit.commits",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Visual Git",
      "properties": {
        "visualGit.animations": {
          "type": "string",
          "enum": [
            "auto",
            "on",
            "off"
          ],
          "enumItemLabels": [
            "Automático",
            "Sempre ligadas",
            "Sempre desligadas"
          ],
          "enumDescriptions": [
            "Segue o VS Code (configuração \"Reduzir movimento\") e o sistema operacional.",
            "Animações sempre ligadas.",
            "Animações sempre desligadas."
          ],
          "default": "auto",
          "description": "Controla as animações da tela do Visual Git."
        },
        "visualGit.parentFolderRepos": {
          "type": "string",
          "enum": [
            "ask",
            "always"
          ],
          "enumItemLabels": [
            "Perguntar",
            "Sempre mostrar"
          ],
          "enumDescriptions": [
            "Pergunta antes de mostrar o histórico de um Git que está numa pasta acima da aberta.",
            "Mostra sem perguntar. Não muda nada no Git do VS Code; se git.openRepositoryInParentFolders for \"never\", ele continua valendo."
          ],
          "default": "ask",
          "scope": "application",
          "description": "O que o Visual Git faz quando o Git do projeto está numa pasta acima da pasta aberta. Só vale nas configurações do usuário (um projeto não consegue mudar)."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\" \"webview/**/*.test.ts\"",
    "check": "npm run typecheck && npm test",
    "vscode:prepublish": "npm run check && node esbuild.mjs --production",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "~1.90.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "preact": "^11.1.1",
    "typescript": "^7.0.2"
  }
}
